generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUBSCRIBER
}

enum JobStatus {
  DUE
  RUNNING
  DONE
  FAILED
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum PredictionStage {
  SELECTION
  PRELIMINARY
}

enum TicketTier {
  STANDARD
  VALUE
  HIGH
}

enum TicketStatus {
  PUBLISHED
  SETTLED
  VOID
}

enum SettlementOutcome {
  WIN
  LOSS
  VOID
  PENDING
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  emailVerified DateTime?
  image     String?
  role      UserRole @default(SUBSCRIBER)
  activeTo  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
  accounts  Account[]
  sessions  Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AdminCredential {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobRun {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique
  jobType        String
  runAfter       DateTime
  status         JobStatus @default(DUE)
  attempts       Int       @default(0)
  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  completedAt    DateTime?
  lastError      String?
  payload        Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([leaseExpiresAt])
}

model ApiQuotaUsage {
  id           String   @id @default(cuid())
  usageDate    DateTime @unique @db.Date
  requestCount Int      @default(0)
  quotaLimit   Int
  safetyPercent Int     @default(90)
  degradedAt   DateTime?
  updatedAt    DateTime @updatedAt
}

model RawProviderPayload {
  id           String   @id @default(cuid())
  endpoint     String
  requestKey   String
  page         Int
  receivedAt   DateTime @default(now())
  providerUpdatedAt DateTime?
  body         Json
  oddsQuotes   OddsQuote[]

  @@unique([endpoint, requestKey, page, receivedAt])
  @@index([endpoint, requestKey])
}

model Competition {
  id         String    @id @default(cuid())
  providerId Int       @unique
  name       String
  country    String?
  fixtures   Fixture[]
  modelRuns  ModelRun[]
  createdAt  DateTime  @default(now())
}

model Team {
  id         String    @id @default(cuid())
  providerId Int       @unique
  name       String
  homeFixtures Fixture[] @relation("home_team")
  awayFixtures Fixture[] @relation("away_team")
}

model Fixture {
  id          String        @id @default(cuid())
  providerId  Int           @unique
  competitionId String
  homeTeamId  String
  awayTeamId  String
  kickoff     DateTime
  status      FixtureStatus @default(SCHEDULED)
  statusCode  String?
  elapsedMinute Int?
  homeGoals   Int?
  awayGoals   Int?
  receivedAt  DateTime      @default(now())
  competition Competition   @relation(fields: [competitionId], references: [id])
  homeTeam    Team          @relation("home_team", fields: [homeTeamId], references: [id])
  awayTeam    Team          @relation("away_team", fields: [awayTeamId], references: [id])
  quotes      OddsQuote[]
  predictions Prediction[]
  ticketLegs  TicketLeg[]
  validationPicks ValidationPick[]
  candidateSnapshots CandidateSnapshot[]
  paperDecisions PaperDecision[]

  @@index([kickoff, status])
  @@index([competitionId, kickoff])
}

model Bookmaker {
  id         String      @id @default(cuid())
  providerId Int         @unique
  name       String
  priority   Int         @default(999)
  active     Boolean     @default(false)
  quotes     OddsQuote[]
}

model Market {
  id          String      @id @default(cuid())
  providerId  Int         @unique
  name        String
  normalizedKey String?
  selectionEnabled Boolean @default(false)
  quotes      OddsQuote[]
  predictions Prediction[]
}

model OddsQuote {
  id                String   @id @default(cuid())
  fixtureId         String
  bookmakerId       String
  marketId          String
  selection         String
  decimalOdds       Decimal  @db.Decimal(10, 4)
  providerUpdatedAt DateTime?
  capturedAt        DateTime
  receivedAt        DateTime @default(now())
  rawPayloadId      String?
  fixture           Fixture  @relation(fields: [fixtureId], references: [id])
  bookmaker         Bookmaker @relation(fields: [bookmakerId], references: [id])
  market            Market   @relation(fields: [marketId], references: [id])
  rawPayload        RawProviderPayload? @relation(fields: [rawPayloadId], references: [id], onDelete: Restrict)
  validationPicks   ValidationPick[]
  candidateSnapshots CandidateSnapshot[]

  @@index([fixtureId, capturedAt])
  @@index([bookmakerId, marketId, selection])
  @@index([rawPayloadId])
}

model ValidationPick {
  id          String   @id @default(cuid())
  ruleKey     String
  fixtureId   String
  marketKey   String
  selection   String
  probability Decimal  @db.Decimal(8, 6)
  decimalOdds Decimal  @db.Decimal(10, 4)
  quoteId     String
  selectedAt  DateTime @default(now())
  capturedAt  DateTime
  fixture     Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Restrict)
  quote       OddsQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@unique([ruleKey, fixtureId, marketKey, selection])
  @@index([ruleKey, selectedAt])
  @@index([fixtureId])
}

model ModelRun {
  id          String   @id @default(cuid())
  competitionId String?
  version     String
  method      String
  trainedUntil DateTime
  artifact    Json
  createdAt   DateTime @default(now())
  competition Competition? @relation(fields: [competitionId], references: [id])
  predictions Prediction[]

  @@index([competitionId, createdAt])
}

model Prediction {
  id          String   @id @default(cuid())
  fixtureId   String
  marketId    String
  selection   String
  probability Decimal  @db.Decimal(8, 6)
  modelRunId  String
  asOfAt      DateTime
  /// Null on legacy rows; new forecasts carry a database insertion timestamp.
  createdAt   DateTime? @default(now())
  stage       PredictionStage @default(SELECTION)
  fixture     Fixture  @relation(fields: [fixtureId], references: [id])
  market      Market   @relation(fields: [marketId], references: [id])
  modelRun    ModelRun @relation(fields: [modelRunId], references: [id])

  @@index([fixtureId, marketId, selection, asOfAt])
}

model TicketVersion {
  id            String       @id @default(cuid())
  targetDate    DateTime     @db.Date
  tier          TicketTier
  status        TicketStatus @default(PUBLISHED)
  bookmakerId   String
  combinedOdds  Decimal      @db.Decimal(12, 4)
  confidenceThreshold Int
  relaxed       Boolean      @default(false)
  publishedAt   DateTime     @default(now())
  lockAt        DateTime
  supersedesId  String?
  candidateSnapshotRunId String?
  decision      Json
  supersedes    TicketVersion? @relation("ticket_successors", fields: [supersedesId], references: [id])
  successors    TicketVersion[] @relation("ticket_successors")
  legs          TicketLeg[]
  settlements   Settlement[]
  candidateSnapshotRun CandidateSnapshotRun? @relation(fields: [candidateSnapshotRunId], references: [id], onDelete: Restrict)

  @@index([targetDate, tier, publishedAt])
  @@index([lockAt])
  @@index([candidateSnapshotRunId])
}

/// Immutable universe evaluated when one or more paper tickets were published. It separates the
/// candidate universe from the subset selected into an accumulator, without changing tickets.
model CandidateSnapshotRun {
  id          String              @id @default(cuid())
  targetDate  DateTime            @db.Date
  capturedAt  DateTime
  policyVersion String
  candidates  CandidateSnapshot[]
  ticketVersions TicketVersion[]
  createdAt   DateTime            @default(now())

  @@index([targetDate, capturedAt])
}

/// One exact quote/prediction candidate from a CandidateSnapshotRun. A null baseEligibilityReason
/// means it cleared the leg-level price, EV, freshness and targeted safeguards at capture time.
model CandidateSnapshot {
  id                  String               @id @default(cuid())
  runId               String
  fixtureId           String
  quoteId             String
  marketKey           String
  selection           String
  decimalOdds         Decimal              @db.Decimal(10, 4)
  modelProbability    Decimal              @db.Decimal(8, 6)
  consensusProbability Decimal             @db.Decimal(8, 6)
  confidenceScore     Int
  conservativeExpectedValue Decimal        @db.Decimal(10, 6)
  baseEligibilityReason String?
  /// Policy result for each tier; null value means eligible for that tier.
  tierEligibility     Json                 @default("{}")
  selected            Boolean              @default(false)
  ticketTier          TicketTier?
  confidenceThreshold Int?
  run                 CandidateSnapshotRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  fixture             Fixture              @relation(fields: [fixtureId], references: [id], onDelete: Restrict)
  quote               OddsQuote            @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@unique([runId, quoteId])
  @@index([runId, selected])
  @@index([fixtureId])
}

model TicketLeg {
  id              String        @id @default(cuid())
  ticketVersionId String
  fixtureId       String
  quoteId         String
  marketKey       String
  selection       String
  decimalOdds     Decimal       @db.Decimal(10, 4)
  probability     Decimal       @db.Decimal(8, 6)
  ticketVersion   TicketVersion @relation(fields: [ticketVersionId], references: [id], onDelete: Restrict)
  fixture         Fixture       @relation(fields: [fixtureId], references: [id])

  @@unique([ticketVersionId, fixtureId])
  @@index([fixtureId])
}

model Settlement {
  id              String            @id @default(cuid())
  ticketVersionId String
  outcome         SettlementOutcome @default(PENDING)
  profitUnits     Decimal?          @db.Decimal(12, 4)
  settledAt       DateTime?
  evidence        Json
  ticketVersion   TicketVersion     @relation(fields: [ticketVersionId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())

  @@unique([ticketVersionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
}

/// Frozen daily artifact for a versioned, paper-only research protocol.
model PaperCalibration {
  id          String @id @default(cuid())
  policyVersion String
  day         String
  cutoffAt    DateTime
  policyHash  String
  artifactHash String
  policy      Json
  artifact    Json
  createdAt   DateTime @default(now())
  decisions   PaperDecision[]
  @@unique([policyVersion, day])
}

/// Exactly one prospective snapshot per fixture and protocol, including PASS decisions.
model PaperDecision {
  id          String @id @default(cuid())
  policyVersion String
  fixtureId   String
  calibrationId String
  decidedAt   DateTime
  kickoff     DateTime
  evidence    Json
  evidenceHash String
  createdAt   DateTime @default(now())
  fixture     Fixture @relation(fields: [fixtureId], references: [id], onDelete: Restrict)
  calibration PaperCalibration @relation(fields: [calibrationId], references: [id], onDelete: Restrict)
  outcome     PaperOutcome?
  @@unique([policyVersion, fixtureId])
  @@index([decidedAt])
}

/// Append-only observed final result; later model fits use only outcomes recorded before their cutoff.
model PaperOutcome {
  id          String @id @default(cuid())
  decisionId  String @unique
  status      String
  homeGoals   Int?
  awayGoals   Int?
  resultReceivedAt DateTime
  recordedAt  DateTime @default(now())
  decision    PaperDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
}
